<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AsusMon.Ui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:AsusMon.Ui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Root" RowDefinitions="Auto,*,Auto">

        <!-- Title bar -->
        <Grid x:Name="AppTitleBar" Height="44" Padding="14,0,0,0" ColumnDefinitions="Auto,*">
            <TextBlock Text="asusmon"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="24,8,24,24">
            <StackPanel Spacing="16">

                <ProgressRing x:Name="Busy" IsActive="True" HorizontalAlignment="Center" Margin="0,32,0,0" />

                <TextBlock x:Name="EmptyState"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <ItemsControl x:Name="MonitorList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="16" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="ui:MonitorViewModel">

                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="20">

                                <StackPanel Spacing="14">

                                    <!-- Header -->
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Title}"
                                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                                            <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="4"
                                                    Padding="6,1"
                                                    VerticalAlignment="Center"
                                                    Visibility="{x:Bind AsusBadgeVisibility}">
                                                <TextBlock Text="ASUS"
                                                           FontSize="11"
                                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Subtitle}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <!-- Current GameVisual preset -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="GameVisual"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <ComboBox x:Name="ModeSelector"
                                                  HorizontalAlignment="Stretch"
                                                  ItemsSource="{x:Bind Modes}"
                                                  SelectedIndex="{x:Bind SelectedModeIndex, Mode=TwoWay}"
                                                  DisplayMemberPath="Label"
                                                  IsEnabled="{x:Bind CanChangeMode}"
                                                  SelectionChanged="OnModeSelectionChanged"
                                                  Tag="{x:Bind}" />
                                    </StackPanel>

                                    <!-- Settings grid -->
                                    <ItemsControl ItemsSource="{x:Bind Settings}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="ui:SettingViewModel">
                                                <Grid ColumnDefinitions="130,*">
                                                    <TextBlock Text="{x:Bind Label}"
                                                               Style="{StaticResource BodyTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{x:Bind Value}"
                                                               TextWrapping="Wrap"
                                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>
                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2"
              Padding="24,12"
              ColumnDefinitions="*,Auto"
              Background="{ThemeResource LayerFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Grid.Column="1" Click="OnRefreshClick" IsEnabled="{x:Bind IsIdle, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

    </Grid>
</Window>

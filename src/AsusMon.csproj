<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- IMAGE_SUBSYSTEM_WINDOWS_CUI. Combined with the consoleAllocationPolicy in
         app.manifest this yields a hybrid app: shells block on it and it inherits
         their console, while Explorer launches it without allocating one. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>

    <AssemblyName>asusmon</AssemblyName>
    <RootNamespace>AsusMon</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>asusmon.ico</ApplicationIcon>

    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <!-- Suppresses the Main the XAML compiler would otherwise generate, so the
         single entry point in Program.cs can choose between console and GUI. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.*" />
  </ItemGroup>

</Project>



